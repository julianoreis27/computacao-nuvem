ell id="n-boot" value="&lt;b style=&quot;font-size:13px&quot;&gt;Inicialização de cada instância (user data)&lt;/b&gt;&lt;br&gt;1. dnf install nodejs git &amp;nbsp;→&amp;nbsp; 2. git clone do repositório &amp;nbsp;→&amp;nbsp; 3. npm ci --omit=dev &amp;nbsp;→&amp;nbsp; 4. gera o .env &amp;nbsp;→&amp;nbsp; 5. systemctl enable --now estoque (reinício automático em caso de falha)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;fillColor=#FFFFFF;strokeColor=#AAB7B8;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="330" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
