# Porta HTTP da aplicação
PORT=3000

# Banco de dados: "dynamodb" ou "postgres" (RDS)
DB_CLIENT=dynamodb

# Cria a tabela automaticamente na inicialização (true/false)
AUTO_CREATE_TABLE=true

# ---------- DynamoDB ----------
AWS_REGION=us-east-1
DYNAMODB_TABLE=Produtos
# Para desenvolvimento com DynamoDB Local (docker compose). Remova na AWS.
DYNAMODB_ENDPOINT=http://localhost:8000
# Credenciais: na AWS prefira uma IAM Role (EC2/ECS/Elastic Beanstalk).
# Para o DynamoDB Local, qualquer valor serve.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ---------- RDS (PostgreSQL) ----------
# DATABASE_URL=postgres://estoque:estoque@localhost:5432/estoque
# No RDS: postgres://USUARIO:SENHA@meu-banco.xxxxxx.us-east-1.rds.amazonaws.com:5432/estoque
# DATABASE_SSL=true
